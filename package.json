{
  "author": "xvoidsx",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "description": "Halo \u2014 a nightshade neon Electron shell that lets herdr run trails locally, with your repos and agents in one live view.",
  "desktopName": "org.xvoidsx.halo",
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^37.0.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "name": "halo",
  "private": true,
  "scripts": {
    "build": "npm run build:renderer && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "dev": "vite",
    "dev:electron": "npm run build:electron && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --linux deb",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder --linux --publish never"
  },
  "type": "module",
  "version": "0.9.0"
}